static var _fields: Array = []


# Distance (pixels verticaux) entre un point relatif à l'ancrage du module et
# sa silhouette ; 0 à l'intérieur.
static func clearance(module: int, point: Vector2) -> float:
	if _fields.is_empty():
		_build()
	var field: Dictionary = _fields[module - 1]
	var cell: Vector2 = ((point - field.origin) / CELL).floor()
	var size: Vector2i = field.size
	if cell.x < 0 or cell.y < 0 or cell.x >= size.x or cell.y >= size.y:
		return FAR
	return field.distances[int(cell.y) * size.x + int(cell.x)]


static func _build() -> void:
	var step := Vector2(CELL * X_UNIT, CELL)
	var diagonal := step.length()
	for module in MODULES:
		var rows: Array = module.rows
		var pad := int(MARGIN / CELL)
		var size := Vector2i(rows[0].length() + 2 * pad, rows.size() + 2 * pad)
		var distances := PackedFloat32Array()
		distances.resize(size.x * size.y)
		distances.fill(FAR)
		for y in rows.size():
			var row: String = rows[y]
			for x in row.length():
				if row[x] == "#":
					distances[(y + pad) * size.x + x + pad] = 0.0
		# Transformée de distance en deux passes (voisinage 3 × 3, cases non carrées).
		var forward := [Vector3i(-1, 0, 0), Vector3i(0, -1, 1), Vector3i(-1, -1, 2), Vector3i(1, -1, 2)]
		var backward := [Vector3i(1, 0, 0), Vector3i(0, 1, 1), Vector3i(1, 1, 2), Vector3i(-1, 1, 2)]
		var costs := [step.x, step.y, diagonal]
		for y in size.y:
			for x in size.x:
				_relax(distances, size, x, y, forward, costs)
		for y in range(size.y - 1, -1, -1):
			for x in range(size.x - 1, -1, -1):
				_relax(distances, size, x, y, backward, costs)
		_fields.append({
			"origin": module.origin - Vector2(pad, pad) * CELL,
			"size": size,
			"distances": distances,
		})


static func _relax(distances: PackedFloat32Array, size: Vector2i, x: int, y: int, neighbours: Array, costs: Array) -> void:
	var index := y * size.x + x
	var best := distances[index]
	for neighbour: Vector3i in neighbours:
		var nx := x + neighbour.x
		var ny := y + neighbour.y
		if nx < 0 or ny < 0 or nx >= size.x or ny >= size.y:
			continue
		best = minf(best, distances[ny * size.x + nx] + costs[neighbour.z])
	distances[index] = best
