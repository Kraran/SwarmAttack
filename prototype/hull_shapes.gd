extends RefCounted

# Silhouettes des modules HD, relevées sur leur rendu à l'écran (outil de
# mesure : rendu isolé de chaque module, flamme du réacteur exclue). Une case
# vaut un demi-pixel logique ; l'origine est le point d'ancrage du module
# (ship_x, module_y). Les collisions « précises » mesurent la distance entre
# le centre de l'ennemi et cette silhouette.

# Les distances sont exprimées en pixels verticaux : un pixel logique
# horizontal ne vaut à l'écran que 192 / 224 d'un pixel vertical.
const X_UNIT := 192.0 / 224.0
const CELL := 0.5
const MARGIN := 12.0
const FAR := 99.0

# Rayon apparent de chaque famille d'ennemis (EnemyKind : anneau,
# intercepteur, pince, météore, rangée), entre le cercle de même aire et le
# demi-encombrement du modèle.
const ENEMY_RADII := [3.9, 5.0, 6.0, 7.3, 3.7]

const MODULES := [
